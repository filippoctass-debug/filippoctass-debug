# Identità sito
SITE_ID=PV_001

# MQTT
MQTT_HOST=100.73.160.84
MQTT_PORT=8883
MQTT_USERNAME=edge_pv_001
MQTT_PASSWORD=test1234

# TLS
MQTT_TLS_CA=/app/certs/ca.crt
MQTT_TLS_INSECURE=true

# Topic base (il driver pubblica su: pv/<SITE_ID>/telemetry, pv/<SITE_ID>/status, ecc.)
MQTT_TOPIC_BASE=pv

# Frequenze
PUBLISH_INTERVAL_S=5

# Buffer locale (sqlite) nel container edge-driver
BUFFER_DB=/app/data/buffer.sqlite3

# Modbus (legacy singolo target)
MODBUS_HOST=192.168.2.108
MODBUS_PORT=5020
MODBUS_UNIT_ID=1

# (opzionale, nuovo formato multi-target)
# MODBUS_TARGETS=192.168.2.108:5020:1,192.168.2.109:502:2

GHCR_USER=filippoctass-debug
