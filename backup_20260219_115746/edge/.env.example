# MQTT
MQTT_HOST=100.100.100.100
MQTT_PORT=8883
MQTT_USERNAME=edge_pv_001
MQTT_PASSWORD=change_me
MQTT_TLS_CA=/app/certs/ca.crt
MQTT_TLS_INSECURE=true
MQTT_TOPIC_BASE=pv
PUBLISH_INTERVAL_S=5

# Identità sito
SITE_ID=PV_001

# Modbus targets (lista separata da virgole)
# formato: ip:port:unitId
# esempi:
# MODBUS_TARGETS=192.168.2.108:502:1,192.168.2.109:502:255
MODBUS_TARGETS=192.168.2.108:502:1
